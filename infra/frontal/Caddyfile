# Proxy frontal del ecosistema (README.md). Un bloque por subdominio; el
# registro DNS es un comodín (*.mmasias.cloud-ip.cc CNAME mmasias.cloud-ip.cc),
# así que un servicio nuevo solo necesita su bloque aquí.

# `defer`: se aplican sobre la respuesta ya recibida de la aplicación y
# sustituyen las suyas, así una cabecera que pongan los dos no sale repetida.
(seguridad) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ------------------------------------------------------------ raíz
# FASE 2 (2026-11-15): la raíz es la portada del ecosistema. pyCelda ya solo
# vive en celda. (login con Google autorizado ahí, OAUTH_REDIRECT_URI y
# FRONTEND_URL de pyCelda actualizados). Cualquier otra ruta (marcadores y
# enlaces antiguos a pyCelda) redirige a celda. con la misma ruta.
mmasias.cloud-ip.cc {
	import seguridad
	root * /etc/caddy/home
	# La raíz no es un fichero real en disco -- hace falta reescribirla a
	# index.html antes de que el matcher `file` de abajo pueda comprobarla.
	@raiz path /
	handle @raiz {
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	# `file` comprueba si la ruta existe como fichero real en home/ (el
	# logo, un css futuro, etc.) -- a diferencia de un listado de rutas,
	# cualquier estático nuevo que se añada ahí se sirve sin tocar este
	# bloque. Lo que no exista cae en la redirección a celda.
	@estatico file
	handle @estatico {
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		redir https://celda.mmasias.cloud-ip.cc{uri} 308
	}
}

# ------------------------------------------------------------ servicios
celda.mmasias.cloud-ip.cc {
	import seguridad
	reverse_proxy pycelda-web:80
}

pulso.mmasias.cloud-ip.cc {
	import seguridad
	reverse_proxy pulso-web:80
}
